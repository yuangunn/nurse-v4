{
  "$comment": "check_redesign.mjs 가 실제 앱(http://localhost:5757)을 1920×1080 으로 열고 이 값들을 getComputedStyle 로 검사한다. 값은 design/*.dc.html 인라인 스타일에서 그대로 뽑았다. 셀렉터는 구현 시 data-rd 속성으로 맞춘다.",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "global": {
    "minFontSizePx": 14,
    "maxFontWeightBelow22px": 700,
    "forbiddenTextColors": [
      "#8A93A1",
      "#B8BFC9",
      "#D4D9E0"
    ],
    "forbiddenTextColorsNote": "ink-3/4/5 는 글자에 쓰지 않는다 (disabled 버튼 제외). 검사: 모든 텍스트 노드의 color.",
    "minClickTargetPx": 40,
    "minClickTargetNote": "button, [role=button], label>input 의 getBoundingClientRect 높이. 표 셀(td)은 36.",
    "iconOnlyButtonsForbidden": true,
    "iconOnlyButtonsNote": "innerText.trim()==='' 인 button 은 실패. 예외: [data-rd=ym-prev], [data-rd=ym-next], [data-rd=modal-close], [data-rd=popup-close], [data-rd=drawer-close], .rnum button",
    "everyButtonHasTitle": true,
    "everyButtonHasTitleNote": "button:not([title]) 개수 0. 현재 204개 중 63개만 title 있음.",
    "primaryPerScreen": 1,
    "primaryPerScreenNote": ".rbtn-primary 가 화면(탭)당 정확히 1개 (모달 열린 상태에서는 모달 내부 1개만 셈).",
    "englishLabelsForbidden": [
      "Ward",
      "Nurses",
      "Year/Mo",
      "OCT",
      "WARD",
      "NURSES",
      "Charge 숨기기",
      "V 무제한",
      "솔버",
      "MIP",
      "HiGHS",
      "CP-SAT",
      "infeasible",
      "slack",
      "penalty"
    ]
  },
